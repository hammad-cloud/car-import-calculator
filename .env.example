# Copy to .env.local for local overrides. Never commit real values; set them in the
# Vercel dashboard (Project > Settings > Environment Variables) instead.
# The app needs no secrets today: there are no API keys, tokens or database credentials.

# --- Backend (FastAPI, read via os.getenv) ---

# Set automatically by Vercel ("production" | "preview" | "development"); don't set it yourself.
# VERCEL_ENV=

# /api/docs and /api/openapi.json are disabled in production. Set to "true" to expose them anyway.
ENABLE_API_DOCS=false

# --- Frontend (Vite) ---
# Anything prefixed VITE_ is compiled into the public JS bundle: never put a secret here.
# See frontend/.env.example. Leave empty to call same-origin /api. If you point it at another
# origin, also add that origin to connect-src in the Content-Security-Policy in vercel.json.
# VITE_API_BASE_URL=
